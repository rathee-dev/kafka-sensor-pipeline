# ---------------------------------------------------------------------------
# Copy to .env and fill in.  NEVER commit .env (it is git-ignored).
# Every value below is optional except KAFKA_BROKERS.
# Works against a hosted cluster (Redpanda Cloud / Confluent Cloud) AND a local
# broker started with `docker compose up -d`.
# ---------------------------------------------------------------------------

# Comma separated host:port list of Kafka brokers. REQUIRED.
# Hosted : redpanda-<id>.<region>.redpanda.com:9092
# Local   : localhost:9092
KAFKA_BROKERS=localhost:9092

# Logical name this app registers with the cluster (shows up in broker metrics).
KAFKA_CLIENT_ID=sensor-pipeline

# TLS. Managed clusters require true. Local docker broker uses false.
KAFKA_SSL=false

# SASL. Leave empty for an unauthenticated local broker.
# Managed clusters: set both, mechanism is usually scram-sha-256.
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=
# init_transient is what Redpanda/Confluent Cloud expect. Use init for old brokers.
KAFKA_SASL_ENDPOINT=init_transient

# Topics created by `npm run topics` if they do not exist yet.
KAFKA_READINGS_TOPIC=sensor-readings
KAFKA_ANOMALY_TOPIC=sensor-anomalies
KAFKA_DLT_TOPIC=sensor-readings-dlt
KAFKA_PARTITIONS=3
# Managed free tiers usually cap this at 1-3; local single broker must be 1.
KAFKA_REPLICATION_FACTOR=1

# Consumer group. Two processes sharing this id split partitions between them.
KAFKA_CONSUMER_GROUP=sensor-analytics

# Producer behaviour.
SENSOR_COUNT=3
READINGS_PER_SENSOR=10
PUBLISH_INTERVAL_MS=200
# sensor  = key = sensorId  -> strict ordering per sensor (default)
# roundrobin = key = null   -> round-robin/sticky partitioning, ordering only per partition
# random = key = randomId   -> deliberately breaks per-sensor ordering
KEY_MODE=sensor
EVENT_SEED=20260930

# Consumer behaviour.
ANOMALY_HIGH_C=80
ANOMALY_LOW_C=-10
VIBRATION_THRESHOLD_MM_S=5
CONSUMER_IDLE_TIMEOUT_MS=0
OUTPUT_DIR=output

LOG_LEVEL=info